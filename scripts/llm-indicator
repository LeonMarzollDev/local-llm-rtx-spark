#!/usr/bin/env python3
# Top-bar menu for the local models: shows which one is loaded and loads/stops them via `llm`.
# Needs gir1.2-ayatanaappindicator3-0.1 and GNOME's AppIndicator extension (both present on Ubuntu).
import datetime
import json
import os
import subprocess
import time
import urllib.request
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Notify", "0.7")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import GLib, Gtk, Notify  # noqa: E402

LLM = str(Path.home() / ".local/bin/llm")
CURRENT = Path.home() / "llm/cache/.current"
MAX_ACTIVE = Path.home() / "llm/cache/.max"            # `llm start --max` paused Spark
LOAD_TIMES = Path.home() / "llm/cache/load-times.json"  # how long each model took to load last time (s)
LAST_FAILURE = Path.home() / "llm/cache/.last-failure"  # why `llm` stopped the last start (its watchdog)
MAX_WANTED = Path.home() / "llm/cache/max-memory"      # the menu switch: load models that way
API = "http://127.0.0.1:8000/v1/models"
VARIANTS = [  # (llm variant, menu text, top-bar label) - by recommendation (measured 2026-10-23/24)
    ("flash", "Flash-Next · MoE FP4 · MTP×3 · 262k · ~60 tok/s · Spark pauses", "Flash"),
    ("flash-512k", "Flash-Next 512k · long context, slower when full · Spark pauses", "Flash 512k"),
    ("27b-fast", "27B Fast · NVFP4 · DFlash2×10 · 262k · ~35 tok/s", "27B Fast"),
    ("27b-agent", "27B Agents · NVFP4 · MTP×4 · prompt cache · ~32 tok/s", "27B Agent"),
    ("27b", "27B · NVFP4 · no speculation · ~12 tok/s", "27B"),
]
NAMES = {v: (text, label) for v, text, label in VARIANTS}
NAMES.update({"27b-mtp": ("27B · NVFP4 · MTP×4", "27B+M"),          # started by scripts or Spark
              "27b-dflash": ("27B · NVFP4 · DFlash2", "27B+D")})
DEFAULT_LOAD = {"flash": 300, "flash-512k": 300}                            # until a load was measured; 27B variants: 180 s
ICON_IDLE = "applications-science-symbolic"
ICON_LOADING = "content-loading-symbolic"
PAD = "\u2002"  # en space: some room around the icon and label in the top bar


def load_started():
    """When the model container started (epoch seconds), or None."""
    try:
        out = subprocess.run(["docker", "inspect", "-f", "{{.State.StartedAt}}", "llm"], capture_output=True,
                             text=True, timeout=3).stdout.strip()
        return datetime.datetime.fromisoformat(out[:26].rstrip("Z") + "+00:00").timestamp() if out else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def load_times():
    try:
        return json.loads(LOAD_TIMES.read_text())
    except (OSError, ValueError):
        return {}


def clock(seconds):
    seconds = max(0, int(seconds))
    return f"{seconds // 60}:{seconds % 60:02d}"


def api_ready():
    try:
        with urllib.request.urlopen(API, timeout=1):
            return True
    except OSError:
        return False


METRICS = "http://127.0.0.1:8000/metrics"
COUNTERS = {"generated": "vllm:generation_tokens_total", "prompt": "vllm:prompt_tokens_total",
            "cached": "vllm:prefix_cache_hits_total", "decode_time": "vllm:inter_token_latency_seconds_sum",
            "prefill_time": "vllm:request_prefill_time_seconds_sum",
            "prefills": "vllm:request_prefill_time_seconds_count",
            "drafted": "vllm:spec_decode_num_draft_tokens_total",
            "accepted": "vllm:spec_decode_num_accepted_tokens_total"}


def read_metrics():
    """vLLM's running counters (summed over labels), or None."""
    try:
        with urllib.request.urlopen(METRICS, timeout=1) as resp:
            text = resp.read().decode()
    except OSError:
        return None
    values = dict.fromkeys(COUNTERS, 0.0)
    names = {v: k for k, v in COUNTERS.items()}
    for line in text.splitlines():
        name = line.split("{", 1)[0].split(" ", 1)[0]
        if name in names:
            try:
                values[names[name]] += float(line.rsplit(" ", 1)[1])
            except ValueError:
                pass
    return values


def kilo(n):
    return f"{n / 1000:.1f}k" if n >= 1000 else f"{n:.0f}"


class LlmIndicator:
    def __init__(self):
        Notify.init("Local models")
        self.job = None          # running `llm start/stop` process started from the menu
        self.job_variant = None
        self.loading = None      # (variant, container start) of the load being shown
        self.last_cleanup = 0.0
        self.metrics = None      # last counters of the model server
        self.live = None         # what the model does right now: "decode" / "prefill" text for the label
        self.last_active = 0.0
        self.new_prompt = 0.0    # prompt tokens not from the cache since the last finished prefill
        self.last = {}           # the last measured numbers: decode / prompt / mtp
        self.stats = ""          # the same as one line for the menu
        self.indicator = AppIndicator.Indicator.new(
            "llm-indicator", ICON_IDLE, AppIndicator.IndicatorCategory.APPLICATION_STATUS)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("Local models")

        menu = Gtk.Menu()
        self.status_item = Gtk.MenuItem(label="")
        self.status_item.set_sensitive(False)
        menu.append(self.status_item)
        menu.append(Gtk.SeparatorMenuItem())
        self.variant_items = {}
        for variant, text, _ in VARIANTS:
            item = Gtk.MenuItem(label=f"Load {text}")
            item.connect("activate", self.on_start, variant)
            menu.append(item)
            self.variant_items[variant] = item
        self.stop_item = Gtk.MenuItem(label="Stop model")
        self.stop_item.connect("activate", self.on_stop)
        menu.append(self.stop_item)
        # all memory for the model: Spark (~17 GB) and the search pause while it runs, and come back on Stop
        self.max_item = Gtk.CheckMenuItem(label="Max memory (Spark pauses while a model runs)")
        self.max_item.set_active(MAX_WANTED.exists())
        self.max_item.connect("toggled", self.on_max)
        menu.append(self.max_item)
        menu.append(Gtk.SeparatorMenuItem())
        logs = Gtk.MenuItem(label="Show log")
        logs.connect("activate", lambda _: self.in_terminal("logs"))
        menu.append(logs)
        bench = Gtk.MenuItem(label="Speed test")
        bench.connect("activate", lambda _: self.in_terminal("bench"))
        menu.append(bench)
        menu.show_all()
        self.indicator.set_menu(menu)

        self.refresh()
        GLib.timeout_add_seconds(3, self.refresh)

    def state(self):
        """(variant or None, 'ready' | 'loading' | 'stopping' | 'idle')"""
        if self.job and self.job_variant == "stop":
            return None, "stopping"
        variant = CURRENT.read_text().strip() if CURRENT.exists() else None
        if not variant:
            return None, "idle"
        if api_ready():
            return variant, "ready"
        # still marked but not answering: after a reboot the container is gone - `llm cleanup` clears that (it
        # leaves a start in progress alone); at most every 30 s
        if not self.job and time.time() - self.last_cleanup > 30:
            self.last_cleanup = time.time()
            subprocess.Popen([LLM, "cleanup"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return variant, "loading"

    def refresh(self):
        variant, state = self.state()
        if state == "ready" and self.loading and self.loading[0] == variant and self.loading[1]:
            times = load_times()                         # learn how long this model takes to load
            took = time.time() - self.loading[1]
            times[variant] = round(took if variant not in times else (times[variant] + took) / 2)
            try:
                LOAD_TIMES.write_text(json.dumps(times))
            except OSError:
                pass
        if state != "loading":
            self.loading = None
        text, label = NAMES.get(variant, (variant or "", variant or ""))
        if state == "ready":
            self.update_live()
            busy = self.live and time.time() - self.last_active < 15
            self.indicator.set_icon_full(ICON_IDLE, f"{text} ready")
            self.indicator.set_label(f"{PAD}{label}{' · ' + self.live if busy else ''}{PAD}",
                                     f"{PAD}Flash · pp 9.9k/s{PAD}")
            self.status_item.set_label(f"● {text} — ready on 127.0.0.1:8000"
                                       + (" · max memory, Spark paused" if MAX_ACTIVE.exists() else "")
                                       + (f"\n   {self.stats}" if self.stats else ""))
        elif state == "loading":
            # a countdown like Spark's: the time since the container started against the last load of this model.
            # Read every time: a new start of the same model replaces the container (the old start time, or none
            # while the memory is being prepared, made the countdown and the learned load time wrong)
            started = load_started()
            if not self.loading or self.loading[0] != variant or self.loading[1] != started:
                self.loading = (variant, started)
            started = self.loading[1]
            expected = load_times().get(variant, DEFAULT_LOAD.get(variant, 180))
            elapsed = time.time() - started if started else 0
            if started and elapsed < expected:
                pct, left = int(100 * elapsed / expected), expected - elapsed
                self.indicator.set_label(f"{PAD}{label} {pct} % · {clock(left)}{PAD}", f"{PAD}Flash 99 % · 99:99{PAD}")
                self.status_item.set_label(f"◌ {text} — loading {pct} % · ~{clock(left)} left")
            else:                                        # longer than last time: show how long it runs
                self.indicator.set_label(f"{PAD}{label} {clock(elapsed)}…{PAD}", f"{PAD}Flash 99 % · 99:99{PAD}")
                self.status_item.set_label(f"◌ {text} — loading for {clock(elapsed)} (longer than last time)")
            self.indicator.set_icon_full(ICON_LOADING, f"{text} loading")
        elif state == "stopping":
            self.indicator.set_icon_full(ICON_LOADING, "stopping")
            self.indicator.set_label(PAD, PAD)
            self.status_item.set_label("◌ stopping…")
        else:
            self.indicator.set_icon_full(ICON_IDLE, "no model loaded")
            self.indicator.set_label(PAD, PAD)
            self.status_item.set_label("No model loaded")
        busy = self.job is not None
        for v, item in self.variant_items.items():
            item.set_sensitive(not busy and not (v == variant and state == "ready"))
        self.stop_item.set_sensitive(not busy and state in ("ready", "loading"))
        return True

    def update_live(self):
        """Speed from the model server's counters since the last refresh (3 s): generation = new tokens per second
        of decoding (with MTP several per step), prompt = tokens read per second of prefill (cached ones excluded)."""
        now = read_metrics()
        prev, self.metrics = self.metrics, now
        if not now or not prev or now["generated"] < prev["generated"]:     # a new server: start over
            self.new_prompt = 0.0
            return
        d = {k: now[k] - prev[k] for k in now}
        self.new_prompt += max(0.0, d["prompt"] - d["cached"])
        parts = {}
        if d["prefills"] > 0 and d["prefill_time"] > 0:
            pp = self.new_prompt / d["prefill_time"]
            cached = d["cached"] / d["prompt"] if d["prompt"] > 0 else 0
            parts["prompt"] = f"prompt {kilo(pp)} tok/s ({cached:.0%} from cache)"
            self.live, self.last_active, self.new_prompt = f"pp {kilo(pp)}/s", time.time(), 0.0
        elif d["prompt"] > 0 and d["generated"] == 0:
            self.live, self.last_active = "reading…", time.time()
        if d["generated"] > 0 and d["decode_time"] > 0:
            tps = d["generated"] / d["decode_time"]
            parts["decode"] = f"generation {tps:.0f} tok/s"
            if d["drafted"] > 0:
                parts["mtp"] = f"MTP guesses accepted {d['accepted'] / d['drafted']:.0%}"
            self.live, self.last_active = f"{tps:.0f} tok/s", time.time()
        if parts:
            self.last.update(parts)
            self.stats = "last: " + " · ".join(self.last[k] for k in ("decode", "prompt", "mtp") if k in self.last)

    def run_llm(self, args, variant, done_message):
        self.job = subprocess.Popen([LLM, *args], stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
        self.job_variant = variant
        self.refresh()

        def check():
            if self.job.poll() is None:
                return True
            ok = self.job.returncode == 0
            self.job = self.job_variant = None
            if ok and done_message:
                self.notify(done_message)
            elif not ok:
                reason = LAST_FAILURE.read_text().strip() if LAST_FAILURE.exists() else ""
                self.notify(f"Loading failed{' — ' + reason if reason else ''} · details: “Show log”")
            self.refresh()
            return False

        GLib.timeout_add_seconds(2, check)

    def on_start(self, _item, variant):
        text = NAMES[variant][0]
        wanted = MAX_WANTED.exists()
        self.notify(f"Loading {text}" + (" (Spark pauses)" if wanted or variant.startswith("flash") else ""))
        self.run_llm(["start", variant] + (["--max"] if wanted else []), variant, f"{text} is ready")

    def on_max(self, item):
        if item.get_active():
            MAX_WANTED.touch()
        else:
            MAX_WANTED.unlink(missing_ok=True)

    def on_stop(self, _item):
        spark_back = MAX_ACTIVE.exists() and MAX_ACTIVE.read_text().strip() != "off"
        self.run_llm(["stop"], "stop", "Model stopped — memory is free again"
                     + (", Spark is back" if spark_back else ""))

    def in_terminal(self, cmd):
        subprocess.Popen(["ptyxis", "-x", f"{LLM} {cmd}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def notify(self, body):
        note = Notify.Notification.new("Local models", body, ICON_IDLE)
        try:
            note.show()
        except GLib.Error:
            pass


if __name__ == "__main__":
    os.chdir(Path.home())
    LlmIndicator()
    Gtk.main()
